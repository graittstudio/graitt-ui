{
  "name": "@grait/ui",
  "version": "0.1.0",
  "description": "Gedeelde tokens, tailwind-preset en UI-componenten voor grAItt Studio's apps (TravelCareGo, TravelCampGo, Close2U)",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "files": [
    "dist",
    "tailwind-preset.js",
    "src/tokens/tokens.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepare": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "peerDependencies": {
    "jspdf": ">=2.5.0",
    "lucide-react": ">=0.300.0",
    "react": ">=18",
    "react-dom": ">=18",
    "recharts": ">=2",
    "xlsx": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "xlsx": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "xlsx": "^0.18.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulirikx/grait-ui.git"
  }
}
